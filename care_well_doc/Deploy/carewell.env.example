# Plantilla de referencia de /etc/carewell/carewell.env en el VPS.
# El archivo real NO está versionado (tiene secretos). Esta plantilla sirve para saber
# qué claves tiene que tener sin exponer los valores reales.
#
# Permisos del archivo real: 640, dueño root:carewell.
# Si lo editás, hace falta reiniciar el servicio: sudo systemctl restart carewell-api

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
TZ=America/Argentina/Buenos_Aires

# Cadena de conexión a SQL Server (usuario CareWellAdmin, no "sa")
ConnectionStrings__CareWellDb=Server=127.0.0.1;Database=CareWell;User ID=CareWellAdmin;Password=REEMPLAZAR;TrustServerCertificate=True;Encrypt=True;

# Firma de JWT
Jwt__Key=REEMPLAZAR
Jwt__Issuer=CareWellAPI
Jwt__Audience=CareWellAPI

# SMTP (Elastic Email) para verificación de email y recuperación de contraseña
Email__Usuario=REEMPLAZAR
Email__UsarSsl=true
Email__RemitenteNombre=CareWell
Email__RemitenteEmail=REEMPLAZAR
Email__Puerto=2525
Email__Password=REEMPLAZAR
Email__Host=smtp.elasticemail.com

# IA (Gemini) — OCR de DNI y resumen diario.
# En producción SIEMPRE VertexAI: el otro proveedor soportado (AIStudio) es de nivel gratuito y
# Google entrena sus modelos con las consignas enviadas, así que queda solo para desarrollo con
# datos ficticios. Ver administracion.md, "Proveedor de IA: configuración por ambiente".
IA__Proveedor=VertexAI
IA__ApiKey=REEMPLAZAR
# Opcionales, sólo para pisar el modelo definido en appsettings.Production.json:
# IA__ModeloVision=gemini-3.5-flash-lite
# IA__ModeloTexto=gemini-3.5-flash-lite
# Envía el JSON Schema de la respuesta al modelo. Ponerlo en false es el rollback si un cambio
# de esquema hace que Gemini devuelva 400 INVALID_ARGUMENT:
# IA__EnviarResponseSchema=true

# Notificaciones push (Firebase) — ruta al JSON de service account, subido aparte por scp
Push__RutaCredenciales=/etc/carewell/REEMPLAZAR.json
