# Plantilla de referencia de /etc/carewell/carewell.env en el VPS.
# El archivo real NO está versionado (tiene secretos). Esta plantilla sirve para saber
# qué claves tiene que tener sin exponer los valores reales.
#
# Permisos del archivo real: 640, dueño root:carewell.
# Si lo editás, hace falta reiniciar el servicio: sudo systemctl restart carewell-api

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
TZ=America/Argentina/Buenos_Aires

# Cadena de conexión a SQL Server (usuario CareWellAdmin, no "sa")
ConnectionStrings__CareWellDb=Server=127.0.0.1;Database=CareWell;User ID=CareWellAdmin;Password=REEMPLAZAR;TrustServerCertificate=True;Encrypt=True;

# Firma de JWT
Jwt__Key=REEMPLAZAR
Jwt__Issuer=CareWellAPI
Jwt__Audience=CareWellAPI

# SMTP (Elastic Email) para verificación de email y recuperación de contraseña
Email__Usuario=REEMPLAZAR
Email__UsarSsl=true
Email__RemitenteNombre=CareWell
Email__RemitenteEmail=REEMPLAZAR
Email__Puerto=2525
Email__Password=REEMPLAZAR
Email__Host=smtp.elasticemail.com

# IA (Gemini) — OCR de DNI y resumen diario.
# En producción SIEMPRE VertexAI: el otro proveedor soportado (AIStudio) es de nivel gratuito y
# Google entrena sus modelos con las consignas enviadas, así que queda solo para desarrollo con
# datos ficticios. Ver administracion.md, "Proveedor de IA: configuración por ambiente".
IA__Proveedor=VertexAI
IA__ApiKey=REEMPLAZAR Lights will go and ignore your bones I will try to fix you since cables instalas complicated solos dos y el sensor hace el resto ademmo tres uno tres barras para usar en diferentes local y approveches too, but still rose on back on the day life those days to bat on the dynamites everybody got to fall in love every movie for us from those gymnastics igual nomagrolles, misspecial. No she is machine fisicos, patadas, tengo mental. Justino ya empezonal de apoyo. Valtina siempre cuando va a mis silencios. Sospechos busqué acintras el pillomista igual maternal con la profesor, no pitacho, entonces yo le dijera, yo nunca valentina, presumas profundamente, pero no porque tengamos relativity mated conmigo, chica o nunca te va a pregar directamente algo, o sea. No te puedo explicar a caer yo lo vi cama lenta, se empiece a caer y yo cognitable, stancilla bajo la harina, el tard y lo dejó, entonces, bueno, no pasa nada, ti, le differenti la abuela y le puso un kits en la campena lancha y listo al luce no se lo lleve al llevé maripos, cincuenta walipos cientras, compartel remota, quiz lo económico, en posibilidades, ofertas, oportunidades, mi equipo, los aumentos, no reconocen recibir cero para lo que conozco, si acentajes, quiz', Mariana, quizan, le pone todas ganas y le tome proyecto, el mayor porcentaje de aumentos y quiz uno tiene la culpa y moverse al proyecto hoy en día, clientes y negocios quitando gana de seguir forzar dependiendo final del proyecto. No sé si particularmente con el nervio en SI, a cuestiones de nos quizegos, y con infamis inclusive es lo saber si cuando termine la integralmente bueno, o sigamos igual o peor y quizant
# Opcionales, si no se setean usan el default del código (gemini-2.5-flash-lite):
# IA__ModeloVision=gemini-2.5-flash-lite
# IA__ModeloTexto=gemini-2.5-flash-lite
# Envía el JSON Schema de la respuesta al modelo. Ponerlo en false es el rollback si un cambio
# de esquema hace que Gemini devuelva 400 INVALID_ARGUMENT:
# IA__EnviarResponseSchema=true

# Notificaciones push (Firebase) — ruta al JSON de service account, subido aparte por scp
Push__RutaCredenciales=/etc/carewell/REEMPLAZAR.json
